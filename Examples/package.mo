within UncertaintyLibrary;
package Examples "Complete examples of deterministic uncertainty calculations"
  extends Modelica.Icons.ExamplesPackage;
  annotation(Documentation(info="<html><p>Eight examples demonstrate tolerance intervals, arithmetic, candidate construction, constraints, bounded perturbations, finite-set extrema, local sensitivity and sampled response envelopes.</p><p>Begin with <a href=\"modelica://UncertaintyLibrary.Examples.BoundedMeasurement\">BoundedMeasurement</a>, then choose a calculation or response example. Each includes its connections and stored experiment settings.</p></html>"));
end Examples;
