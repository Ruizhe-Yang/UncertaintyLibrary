within UncertaintyLibrary.UsersGuide;
class GettingStarted "Load the library and inspect selected bounded errors"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>Load Modelica 4.0.0, then open UncertaintyLibrary/package.mo. Open <a href=\"modelica://UncertaintyLibrary.Examples.BoundedMeasurement\">Examples.BoundedMeasurement</a> and use its stored 0–4 s experiment.</p><p>Plot coordinate.y, additiveValue, gainValue and the lower/upper outputs. Then use <a href=\"modelica://UncertaintyLibrary.Examples.FiniteCandidateWorstCase\">FiniteCandidateWorstCase</a> to inspect how adding one candidate changes the observed maximum.</p></html>"));
end GettingStarted;
