within UncertaintyLibrary.UsersGuide;
class Overview "Deterministic uncertainty representations and calculations"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>UncertaintyLibrary represents closed intervals, selects deterministic perturbations, constructs finite candidate sets and compares supplied responses. The library combines functions for data calculations with signal blocks and small graphical views.</p><p>Use Sets for interval data, Perturbations for selected signal variations, Candidates and Constraints for finite combinations, and Analysis for ranges, sensitivities, margins and response comparisons.</p></html>"));
end Overview;
